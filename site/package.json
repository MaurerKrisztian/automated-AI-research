{
  "name": "ai-research-lab-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Static, searchable website for the studies in this repository, deployable to GitHub Pages.",
  "scripts": {
    "content": "python3 ../tools/studies.py export public/content",
    "dev": "python3 ../tools/studies.py export public/content --force && vite",
    "build": "npm run content && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "katex": "^0.16.47",
    "minisearch": "^7.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@types/hast": "^3.0.4",
    "@types/katex": "^0.16.7",
    "@types/node": "^22.15.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.7"
  }
}
